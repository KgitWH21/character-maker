+const saved=P.roll(P.initial(),null,()=>.4).state;saved.locks.top=true;saved.settings.collection='japanese';saved.settings.structure='separates';const values=JSON.stringify(saved.results),locks=JSON.stringify(saved.locks);const next=L.apply(saved,'?occasion=formal&presentation=f').state;assert.equal(JSON.stringify(next.results),values);assert.equal(JSON.stringify(next.locks),locks);assert.equal(next.settings.collection,'japanese');assert.equal(next.settings.structure,'separates');
